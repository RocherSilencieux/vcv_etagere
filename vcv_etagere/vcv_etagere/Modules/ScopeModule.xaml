<UserControl x:Class="vcv_etagere.ScopeModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="255">

    <Border BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="8"
            Background="#DDDDDD"
            Padding="10">

        <StackPanel>

            <Button Content="✕"
                    Width="20" Height="20"
                    HorizontalAlignment="Right"
                    Click="Delete_Click"/>

            <TextBlock Text="SCOPE"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Canvas x:Name="WaveformCanvas"
                    Width="250" Height="150"
                    Background="Black"
                    Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="10,0" Orientation="Horizontal">
                    <TextBlock Text="IN" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0"/>
                    <Ellipse x:Name="InputPort" Width="16" Height="16" Fill="Blue"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>