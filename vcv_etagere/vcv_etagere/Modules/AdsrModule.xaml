<UserControl x:Class="vcv_etagere.AdsrModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="350">

    <Border BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="8"
            Background="#DDDDDD"
            Padding="10">

        <StackPanel>

            <Button Content="✕"
                    Width="20" Height="20"
                    HorizontalAlignment="Right"
                    Click="Delete_Click"/>

            <TextBlock Text="ADSR"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Attack" FontWeight="SemiBold"/>
            <Slider x:Name="AttackSlider"  Minimum="0.001" Maximum="2" Value="0.1"
                    ValueChanged="AttackSlider_ValueChanged"/>

            <TextBlock Text="Decay" FontWeight="SemiBold"/>
            <Slider x:Name="DecaySlider"   Minimum="0.001" Maximum="2" Value="0.2"
                    ValueChanged="DecaySlider_ValueChanged"/>

            <TextBlock Text="Sustain" FontWeight="SemiBold"/>
            <Slider x:Name="SustainSlider" Minimum="0" Maximum="1" Value="0.7"
                    ValueChanged="SustainSlider_ValueChanged"/>

            <TextBlock Text="Release" FontWeight="SemiBold"/>
            <Slider x:Name="ReleaseSlider" Minimum="0.001" Maximum="3" Value="0.3"
                    ValueChanged="ReleaseSlider_ValueChanged"/>

            <Button x:Name="GateButton"
                    Content="Start"
                    Click="GateButton_Click"
                    Margin="0,10,0,10"
                    Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <StackPanel Margin="10,0">
                    <TextBlock Text="IN" HorizontalAlignment="Center" FontSize="10"/>
                    <Ellipse x:Name="InputPort" Width="16" Height="16" Fill="Blue" Margin="5"/>
                </StackPanel>
                <StackPanel Margin="10,0">
                    <TextBlock Text="OUT" HorizontalAlignment="Center" FontSize="10"/>
                    <Ellipse x:Name="OutputPort" Width="16" Height="16" Fill="Orange" Margin="5"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
